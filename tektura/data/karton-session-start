#!/usr/bin/env sh

if [ -x /usr/bin/karton ]; then
  KARTON_BIN=/usr/bin/karton
elif [ -x "$HOME/.local-karton/bin/karton" ]; then
  KARTON_BIN="$HOME/.local-karton/bin/karton"
else
  KARTON_BIN="$(command -v karton 2>/dev/null || true)"
fi

if [ -z "$KARTON_BIN" ]; then
  exit 1
fi

KARTON_BINDIR=${KARTON_BIN%/*}
export PATH="$KARTON_BINDIR:/usr/bin:/usr/local/bin:$PATH"

if [ -x "$KARTON_BINDIR/karton-sessiond" ]; then
  "$KARTON_BINDIR/karton-sessiond" >/dev/null 2>&1 &
elif command -v karton-sessiond >/dev/null 2>&1; then
  karton-sessiond >/dev/null 2>&1 &
fi

exec env WLR_NO_HARDWARE_CURSORS=1 WLR_DRM_NO_ATOMIC=1 "$KARTON_BIN"
