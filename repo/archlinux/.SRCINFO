pkgbase = kartonde
	pkgver = 0.7.5
	pkgrel = 1
	url = https://github.com/mijsys/Tektura-i-Karton
	arch = x86_64
	license = GPL-2.0-only
	makedepends = git
	makedepends = meson
	makedepends = ninja
	makedepends = pkgconf
	makedepends = wayland
	makedepends = wayland-protocols
	makedepends = wlroots0.20
	makedepends = cairo
	makedepends = pango
	makedepends = glib2
	makedepends = gtk3
	makedepends = gtk4
	makedepends = libpulse
	makedepends = libxkbcommon
	makedepends = libinput
	makedepends = libxml2
	makedepends = pixman
	makedepends = scdoc
	makedepends = gdk-pixbuf2
	makedepends = librsvg
	makedepends = xorg-xwayland
	makedepends = systemd
	source = kartonde::git+https://github.com/mijsys/Tektura-i-Karton.git
	sha256sums = SKIP

pkgname = tektura
	pkgdesc = KartonDE Wayland compositor based on Tektura
	depends = cairo
	depends = glib2
	depends = libinput
	depends = libxkbcommon
	depends = libxml2
	depends = pango
	depends = pixman
	depends = wayland
	depends = wlroots0.20
	depends = xorg-xwayland
	optdepends = grim: screenshot backend
	optdepends = slurp: area screenshot selection
	optdepends = wl-clipboard: copy screenshots to clipboard

pkgname = karton-shell
	pkgdesc = KartonDE shell with top panel, side dock and desktop popups
	depends = cairo
	depends = gdk-pixbuf2
	depends = glib2
	depends = gtk4
	depends = libpulse
	depends = libxkbcommon
	depends = pango
	depends = wayland

pkgname = karton-settings
	pkgdesc = KartonDE desktop settings application (WIP build)
	depends = glib2
	depends = gtk4
	optdepends = wlr-randr: monitor layout backend for display settings
	optdepends = brightnessctl: brightness backend for internal displays
	optdepends = ddcutil: brightness fallback backend for external displays
	optdepends = gammastep: night light backend
	optdepends = wlsunset: alternative night light backend

pkgname = karton-files
	pkgdesc = KartonDE GTK file manager
	depends = glib2
	depends = gtk4

pkgname = karton-session
	pkgdesc = Session services and desktop helpers for KartONDE
	depends = glib2
	depends = gtk4
	optdepends = grim: screenshot backend
	optdepends = slurp: area screenshot selection
	optdepends = wl-clipboard: copy screenshots to clipboard

pkgname = kartonde
	pkgdesc = Complete KartONDE desktop environment metapackage
	install = kartonde.install
	depends = tektura
	depends = karton-shell
	depends = karton-settings
	depends = karton-files
	depends = karton-session
	optdepends = wlr-randr: monitor layout backend for display settings
	optdepends = brightnessctl: brightness backend for internal displays
	optdepends = ddcutil: brightness fallback backend for external displays
	optdepends = gammastep: night light backend
	optdepends = wlsunset: alternative night light backend
	optdepends = grim: screenshot backend
	optdepends = slurp: area screenshot selection
	optdepends = wl-clipboard: copy screenshots to clipboard
	backup = etc/xdg/karton/autostart
	backup = etc/xdg/karton/environment
	backup = etc/xdg/karton/rc.xml
	backup = etc/xdg/karton/theme.toml
