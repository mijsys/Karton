#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

pids=""

TEXTDOMAIN=karton-session
export TEXTDOMAIN

if [ -n "${KARTON_LOCALEDIR:-}" ] && [ -d "${KARTON_LOCALEDIR}" ]; then
	TEXTDOMAINDIR="${KARTON_LOCALEDIR}"
	export TEXTDOMAINDIR
elif [ -d "${HOME}/.local-karton/share/locale" ]; then
	TEXTDOMAINDIR="${HOME}/.local-karton/share/locale"
	export TEXTDOMAINDIR
fi

_() {
	if command -v gettext >/dev/null 2>&1; then
		gettext "$1"
	else
		printf '%s' "$1"
	fi
}

if command -v kanshi >/dev/null 2>&1; then
	kanshi >/dev/null 2>&1 &
	pids="$pids $!"
fi

if command -v swayidle >/dev/null 2>&1; then
	swayidle -w \
		timeout 300 'swaylock -f -c 000000' \
		timeout 600 'wlopm --off \*' \
		resume 'wlopm --on \*' \
		before-sleep 'swaylock -f -c 000000' >/dev/null 2>&1 &
	pids="$pids $!"
fi

if [ -n "$pids" ]; then
	wait
	exit 0
fi

echo "$(_ "karton-settingsd: no backends found (kanshi/swayidle), running idle fallback")" >&2
while :; do
	sleep 3600

done
