#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

pids=""

TEXTDOMAIN=karton-session
export TEXTDOMAIN

if [ -n "${KARTON_LOCALEDIR:-}" ] && [ -d "${KARTON_LOCALEDIR}" ]; then
	TEXTDOMAINDIR="${KARTON_LOCALEDIR}"
	export TEXTDOMAINDIR
elif [ -d "${HOME}/.local-karton/share/locale" ]; then
	TEXTDOMAINDIR="${HOME}/.local-karton/share/locale"
	export TEXTDOMAINDIR
fi

_() {
	if command -v gettext >/dev/null 2>&1; then
		gettext "$1"
	else
		printf '%s' "$1"
	fi
}

read_lockscreen_override() {
	file="${XDG_CONFIG_HOME:-$HOME/.config}/karton/lockscreen-path"
	[ -r "$file" ] || return 1

	value="$(sed -n '1p' "$file" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
	[ -n "$value" ] || return 1
	[ -f "$value" ] || return 1

	printf '%s\n' "$value"
}

run_lock_screen() {
	if ! command -v swaylock >/dev/null 2>&1; then
		return 0
	fi

	image="$(read_lockscreen_override 2>/dev/null || true)"
	if [ -n "$image" ]; then
		swaylock -f -i "$image" >/dev/null 2>&1 || swaylock -f -c 000000 >/dev/null 2>&1
	else
		swaylock -f -c 000000 >/dev/null 2>&1
	fi
}

if [ "${1:-}" = "--lock-now" ]; then
	run_lock_screen
	exit 0
fi

if command -v kanshi >/dev/null 2>&1; then
	kanshi >/dev/null 2>&1 &
	pids="$pids $!"
fi

if command -v swayidle >/dev/null 2>&1; then
	self_cmd="$0"
	case "$self_cmd" in
		*/*) ;;
		*) self_cmd="$(command -v "$self_cmd" 2>/dev/null || printf '%s' "$self_cmd")" ;;
	esac
	lock_action="\"$self_cmd\" --lock-now"

	swayidle -w \
		timeout 300 "$lock_action" \
		timeout 600 'wlopm --off \*' \
		resume 'wlopm --on \*' \
		before-sleep "$lock_action" >/dev/null 2>&1 &
	pids="$pids $!"
fi

if [ -n "$pids" ]; then
	wait
	exit 0
fi

echo "$(_ "karton-settingsd: no backends found (kanshi/swayidle), running idle fallback")" >&2
while :; do
	sleep 3600

done
