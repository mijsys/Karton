#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

pids=""

TEXTDOMAIN=karton-session
export TEXTDOMAIN

if [ -n "${KARTON_LOCALEDIR:-}" ] && [ -d "${KARTON_LOCALEDIR}" ]; then
	TEXTDOMAINDIR="${KARTON_LOCALEDIR}"
	export TEXTDOMAINDIR
elif [ -d "${HOME}/.local-karton/share/locale" ]; then
	TEXTDOMAINDIR="${HOME}/.local-karton/share/locale"
	export TEXTDOMAINDIR
fi

_() {
	if command -v gettext >/dev/null 2>&1; then
		gettext "$1"
	else
		printf '%s' "$1"
	fi
}

read_lockscreen_override() {
	file="${XDG_CONFIG_HOME:-$HOME/.config}/karton/lockscreen-path"
	[ -r "$file" ] || return 1

	value="$(sed -n '1p' "$file" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
	[ -n "$value" ] || return 1
	[ -f "$value" ] || return 1

	printf '%s\n' "$value"
}

run_lock_screen() {
	if ! command -v swaylock >/dev/null 2>&1; then
		return 0
	fi

	image="$(read_lockscreen_override 2>/dev/null || true)"
	if [ -n "$image" ]; then
		swaylock -f -i "$image" >/dev/null 2>&1 || swaylock -f -c 000000 >/dev/null 2>&1
	else
		swaylock -f -c 000000 >/dev/null 2>&1
	fi
}

if [ "${1:-}" = "--lock-now" ]; then
	run_lock_screen
	exit 0
fi

if command -v kanshi >/dev/null 2>&1; then
	kanshi >/dev/null 2>&1 &
	pids="$pids $!"
fi

start_idle_backend() {
	[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/karton/environment" ] && . "${XDG_CONFIG_HOME:-$HOME/.config}/karton/environment"
	if ! command -v swayidle >/dev/null 2>&1; then
		return 0
	fi
	self_cmd="$0"
	case "$self_cmd" in
		*/*) ;;
		*) self_cmd="$(command -v "$self_cmd" 2>/dev/null || printf '%s' "$self_cmd")" ;;
	esac
	lock_action="\"$self_cmd\" --lock-now"

	blank_time="${KARTON_IDLE_DELAY:-300}"
	lock_time="${KARTON_LOCK_DELAY:-0}"

	if [ "$blank_time" = "0" ]; then
		return 0
	fi

	# Odczyt bezpośrednio z gsettings (jako wariant fallback/główny dla GNOME DB)
	if command -v gsettings >/dev/null 2>&1; then
		gs_blank="$(gsettings get org.gnome.desktop.session idle-delay 2>/dev/null || echo 300)"
		gs_lock="$(gsettings get org.gnome.desktop.screensaver lock-delay 2>/dev/null || echo 0)"
		gs_lock_en="$(gsettings get org.gnome.desktop.screensaver lock-enabled 2>/dev/null || echo true)"
		
		# Typ gsettings to uint32, pozbywamy się "uint32 " z wyniku
		blank_time="${gs_blank##* }"
		[ "$blank_time" = "0" ] && return 0
		lock_time="${gs_lock##* }"
		[ "$gs_lock_en" = "true" ] && act_lock="1" || act_lock="0"
	else
		act_lock="${KARTON_LOCK_ENABLED:-1}"
	fi

	if [ "$act_lock" = "1" ] && [ "$lock_time" != "0" ]; then
		action_lock_time=$((blank_time + lock_time))
		swayidle -w \
			timeout "$blank_time" 'wlopm --off \*' \
			timeout "$action_lock_time" "$lock_action" \
			resume 'wlopm --on \*' \
			before-sleep "$lock_action" >/dev/null 2>&1 &
	elif [ "$act_lock" = "1" ]; then
		swayidle -w \
			timeout "$blank_time" 'wlopm --off \*' \
			timeout "$blank_time" "$lock_action" \
			resume 'wlopm --on \*' \
			before-sleep "$lock_action" >/dev/null 2>&1 &
	else
		swayidle -w \
			timeout "$blank_time" 'wlopm --off \*' \
			resume 'wlopm --on \*' >/dev/null 2>&1 &
	fi
	pids="$pids $!"
	idle_pid="$!"
}

# Nasłuchiwanie zmian dla przeładowania uśpienia (np. SIGUSR1)
trap 'if [ -n "$idle_pid" ]; then kill "$idle_pid"; wait "$idle_pid" 2>/dev/null; fi; start_idle_backend' USR1

start_idle_backend

if [ -n "$pids" ]; then
	wait
	exit 0
fi

echo "$(_ "karton-settingsd: no backends found (kanshi/swayidle), running idle fallback")" >&2
while :; do
	sleep 3600

done
