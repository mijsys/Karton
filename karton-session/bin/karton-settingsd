#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

pids=""

TEXTDOMAIN=karton-session
export TEXTDOMAIN

if [ -n "${KARTON_LOCALEDIR:-}" ] && [ -d "${KARTON_LOCALEDIR}" ]; then
	TEXTDOMAINDIR="${KARTON_LOCALEDIR}"
	export TEXTDOMAINDIR
elif [ -d "${HOME}/.local-karton/share/locale" ]; then
	TEXTDOMAINDIR="${HOME}/.local-karton/share/locale"
	export TEXTDOMAINDIR
fi

_() {
	if command -v gettext >/dev/null 2>&1; then
		gettext "$1"
	else
		printf '%s' "$1"
	fi
}

run_lock_screen() {
	if command -v karton-lock >/dev/null 2>&1; then
		karton-lock >/dev/null 2>&1
		return 0
	fi

	echo "$(_ "karton-settingsd: karton-lock not found, cannot lock session")" >&2
	return 0
}

if [ "${1:-}" = "--lock-now" ]; then
	run_lock_screen
	exit 0
fi

if command -v kanshi >/dev/null 2>&1; then
	kanshi >/dev/null 2>&1 &
	pids="$pids $!"
fi

start_idle_backend() {
	[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/karton/environment" ] && . "${XDG_CONFIG_HOME:-$HOME/.config}/karton/environment"
	if command -v karton-idle >/dev/null 2>&1; then
		karton-idle >/dev/null 2>&1 &
		idle_pid="$!"
		pids="$pids $!"
		return 0
	fi
	echo "$(_ "karton-settingsd: karton-idle not found, idle management disabled")" >&2
	return 0
}

# Nasłuchiwanie zmian dla przeładowania uśpienia (np. SIGUSR1)
trap 'if [ -n "$idle_pid" ]; then kill "$idle_pid"; wait "$idle_pid" 2>/dev/null; fi; start_idle_backend' USR1

start_idle_backend

if [ -n "$pids" ]; then
	wait
	exit 0
fi

echo "$(_ "karton-settingsd: no backends found (kanshi/karton-idle), running idle fallback")" >&2
while :; do
	sleep 3600

done
