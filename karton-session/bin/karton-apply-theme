#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

set -eu

config_root="${XDG_CONFIG_HOME:-$HOME/.config}/karton"
mkdir -p "$config_root" "${XDG_CONFIG_HOME:-$HOME/.config}/gtk-3.0" "${XDG_CONFIG_HOME:-$HOME/.config}/gtk-4.0"

read_mode_from_css() {
  css_file="$config_root/shell.css"
  [ -r "$css_file" ] || return 1
  mode="$(awk -F: '/--theme-mode[[:space:]]*:/ { gsub(/[[:space:];]/, "", $2); print tolower($2); exit }' "$css_file")"
  [ -n "$mode" ] || return 1
  printf '%s\n' "$mode"
}

read_mode_from_file() {
  mode_file="$config_root/theme-mode"
  [ -r "$mode_file" ] || return 1
  mode="$(tr -d '[:space:]' < "$mode_file" | tr '[:upper:]' '[:lower:]')"
  [ -n "$mode" ] || return 1
  printf '%s\n' "$mode"
}

mode="${1:-}"
if [ "$mode" = "--sync-from-css" ] || [ -z "$mode" ]; then
  mode=""
fi
if [ -z "$mode" ]; then
  mode="$(read_mode_from_file || true)"
fi
if [ -z "$mode" ]; then
  mode="$(read_mode_from_css || true)"
fi
if [ -z "$mode" ]; then
  mode="auto"
fi

case "$mode" in
  light|dark|auto) ;;
  *) mode="auto" ;;
esac

printf '%s\n' "$mode" > "$config_root/theme-mode"

resolved="$mode"
if [ "$mode" = "auto" ]; then
  hour="$(date +%H)"
  if [ "$hour" -ge 19 ] || [ "$hour" -lt 7 ]; then
    resolved="dark"
  else
    resolved="light"
  fi
fi

have_dir() {
  name="$1"
  [ -d "/usr/share/$name" ] || [ -d "$HOME/.local/share/$name" ] || [ -d "$HOME/.$name" ]
}

theme_exists() {
  name="$1"
  [ -d "/usr/share/themes/$name" ] || [ -d "$HOME/.themes/$name" ] || [ -d "$HOME/.local/share/themes/$name" ]
}

pick_icon_theme() {
  mode="$1"

  if [ "$mode" = "dark" ]; then
    for theme in Tela-dark Papirus-Dark breeze-dark Tela Papirus Adwaita hicolor; do
      if [ -d "/usr/share/icons/$theme" ] || [ -d "$HOME/.icons/$theme" ] || [ -d "$HOME/.local/share/icons/$theme" ]; then
        printf '%s\n' "$theme"
        return 0
      fi
    done
  else
    for theme in Tela Papirus breeze Kora Adwaita hicolor; do
      if [ -d "/usr/share/icons/$theme" ] || [ -d "$HOME/.icons/$theme" ] || [ -d "$HOME/.local/share/icons/$theme" ]; then
        printf '%s\n' "$theme"
        return 0
      fi
    done
  fi

  printf 'hicolor\n'
}

pick_gtk_theme() {
  mode="$1"
  if [ "$mode" = "dark" ]; then
    for theme in Breeze-Dark Adwaita-dark Graphite-Dark GraphiteDark Catppuccin-Mocha-Standard-Blue-Dark Adwaita; do
      if theme_exists "$theme"; then
        printf '%s\n' "$theme"
        return 0
      fi
    done
  else
    for theme in Breeze Adwaita Graphite-Light GraphiteLight Catppuccin-Latte-Standard-Blue-Light Adwaita-dark; do
      if theme_exists "$theme"; then
        printf '%s\n' "$theme"
        return 0
      fi
    done
  fi
  printf 'Adwaita\n'
}

set_ini_key() {
  file="$1"
  key="$2"
  value="$3"

  if [ ! -f "$file" ]; then
    printf '[Settings]\n' > "$file"
  fi

  if ! grep -q '^\[Settings\]' "$file"; then
    tmp_header="$(mktemp)"
    {
      printf '[Settings]\n'
      cat "$file"
    } > "$tmp_header"
    mv "$tmp_header" "$file"
  fi

  tmp_file="$(mktemp)"
  awk -v k="$key" -v v="$value" '
    BEGIN { done=0 }
    $0 ~ "^" k "=" {
      if (!done) {
        print k "=" v
        done=1
      }
      next
    }
    { print }
    END {
      if (!done) {
        print k "=" v
      }
    }
  ' "$file" > "$tmp_file"
  mv "$tmp_file" "$file"
}

icon_theme="$(pick_icon_theme "$resolved")"
gtk_theme="$(pick_gtk_theme "$resolved")"
prefer_dark="false"
if [ "$resolved" = "dark" ]; then
  prefer_dark="true"
fi

gtk3="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-3.0/settings.ini"
gtk4="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-4.0/settings.ini"

set_ini_key "$gtk3" "gtk-application-prefer-dark-theme" "$prefer_dark"
set_ini_key "$gtk3" "gtk-theme-name" "$gtk_theme"
set_ini_key "$gtk3" "gtk-icon-theme-name" "$icon_theme"
set_ini_key "$gtk3" "gtk-font-name" "Inter 10"
set_ini_key "$gtk3" "gtk-decoration-layout" "minimize,maximize,close"

set_ini_key "$gtk4" "gtk-application-prefer-dark-theme" "$prefer_dark"
set_ini_key "$gtk4" "gtk-theme-name" "$gtk_theme"
set_ini_key "$gtk4" "gtk-icon-theme-name" "$icon_theme"
set_ini_key "$gtk4" "gtk-font-name" "Inter 10"
set_ini_key "$gtk4" "gtk-decoration-layout" "minimize,maximize,close"

if [ "$resolved" = "dark" ]; then
  cat > "$config_root/themerc-override" <<'EOF'
# KartonDE decorations override
# Synced by karton-apply-theme (dark)

window.active.title.bg: Solid
window.inactive.title.bg: Solid
window.active.title.bg.color: #1C1540EE
window.inactive.title.bg.color: #27204BDE

window.active.border.color: #9E8CF7C0
window.inactive.border.color: #7568A39E

window.active.label.text.color: #F2EEFF
window.inactive.label.text.color: #C2B9E7
window.label.text.justify: Left

window.titlebar.padding.width: 8
window.titlebar.padding.height: 6
window.title.separator.width: 0

window.button.width: 14
window.button.height: 14
window.button.spacing: 6
window.button.hover.bg.corner-radius: 9
window.button.hover.bg.color: #D5CCFF2D

window.active.button.unpressed.image.color: #DDD3FF
window.inactive.button.unpressed.image.color: #AA9FD5

window.active.button.iconify.unpressed.image.color: #A9B8FF
window.active.button.max.unpressed.image.color: #77D5B2
window.active.button.close.unpressed.image.color: #FF8CAE

window.inactive.button.iconify.unpressed.image.color: #9FAFE0
window.inactive.button.max.unpressed.image.color: #88BEA2
window.inactive.button.close.unpressed.image.color: #C18AA6
EOF
else
  cat > "$config_root/themerc-override" <<'EOF'
# KartonDE decorations override
# Synced by karton-apply-theme (light)

window.active.title.bg: Solid
window.inactive.title.bg: Solid
window.active.title.bg.color: #FBF8FFF2
window.inactive.title.bg.color: #EFE8FFDF

window.active.border.color: #8E7AE9B8
window.inactive.border.color: #AE9FD39A

window.active.label.text.color: #2E2450
window.inactive.label.text.color: #5D4F87
window.label.text.justify: Left

window.titlebar.padding.width: 8
window.titlebar.padding.height: 6
window.title.separator.width: 0

window.button.width: 14
window.button.height: 14
window.button.spacing: 6
window.button.hover.bg.corner-radius: 9
window.button.hover.bg.color: #8B78F62A

window.active.button.unpressed.image.color: #5C4D8B
window.inactive.button.unpressed.image.color: #8E82B8

window.active.button.iconify.unpressed.image.color: #708CFF
window.active.button.max.unpressed.image.color: #53C89A
window.active.button.close.unpressed.image.color: #EA6C92

window.inactive.button.iconify.unpressed.image.color: #96A7E2
window.inactive.button.max.unpressed.image.color: #8EC4A7
window.inactive.button.close.unpressed.image.color: #CC8FA8
EOF
fi

if command -v karton >/dev/null 2>&1; then
  karton --reconfigure >/dev/null 2>&1 || true
fi
if [ -n "${KARTON_PID:-}" ]; then
  kill -HUP "$KARTON_PID" >/dev/null 2>&1 || true
fi

exit 0
