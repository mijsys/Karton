#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

set -eu

config_root="${XDG_CONFIG_HOME:-$HOME/.config}/karton"
mkdir -p "$config_root" "${XDG_CONFIG_HOME:-$HOME/.config}/gtk-3.0" "${XDG_CONFIG_HOME:-$HOME/.config}/gtk-4.0"

theme_tokens="$config_root/theme.toml"

read_mode_from_css() {
  css_file="$config_root/shell.css"
  [ -r "$css_file" ] || return 1
  mode="$(awk -F: '/--theme-mode[[:space:]]*:/ { gsub(/[[:space:];]/, "", $2); print tolower($2); exit }' "$css_file")"
  [ -n "$mode" ] || return 1
  printf '%s\n' "$mode"
}

read_mode_from_file() {
  mode_file="$config_root/theme-mode"
  [ -r "$mode_file" ] || return 1
  mode="$(tr -d '[:space:]' < "$mode_file" | tr '[:upper:]' '[:lower:]')"
  [ -n "$mode" ] || return 1
  printf '%s\n' "$mode"
}

toml_get() {
  file="$1"
  section="$2"
  key="$3"
  [ -r "$file" ] || return 1
  awk -v sec="$section" -v key="$key" '
    BEGIN { insec = 0 }
    /^[[:space:]]*\[/ {
      s = $0
      gsub(/^[[:space:]]*\[/, "", s)
      gsub(/\][[:space:]]*$/, "", s)
      insec = (s == sec)
      next
    }
    insec {
      line = $0
      sub(/^[[:space:]]+/, "", line)
      if (line ~ /^#/ || line == "") next
      eq = index(line, "=")
      if (!eq) next
      k = substr(line, 1, eq - 1)
      gsub(/[[:space:]]/, "", k)
      if (k != key) next
      v = substr(line, eq + 1)
      sub(/^[[:space:]]+/, "", v)
      sub(/[[:space:]]+$/, "", v)
      if (v ~ /^".*"$/) {
        sub(/^"/, "", v)
        sub(/"$/, "", v)
      }
      print v
      exit
    }
  ' "$file"
}

token_or_default() {
  file="$1"
  section="$2"
  key="$3"
  default="$4"
  value="$(toml_get "$file" "$section" "$key" 2>/dev/null || true)"
  if [ -z "$value" ]; then
    value="$default"
  fi
  printf '%s\n' "$value"
}

have_icon_theme() {
  t="$1"
  [ -d "/usr/share/icons/$t" ] || [ -d "$HOME/.icons/$t" ] || [ -d "$HOME/.local/share/icons/$t" ]
}

theme_exists() {
  t="$1"
  [ -d "/usr/share/themes/$t" ] || [ -d "$HOME/.themes/$t" ] || [ -d "$HOME/.local/share/themes/$t" ]
}

list_installed_names() {
  kind="$1"
  case "$kind" in
    icons)
      set -- "/usr/share/icons" "$HOME/.icons" "$HOME/.local/share/icons"
      ;;
    themes)
      set -- "/usr/share/themes" "$HOME/.themes" "$HOME/.local/share/themes"
      ;;
    *)
      return 1
      ;;
  esac

  for base in "$@"; do
    [ -d "$base" ] || continue
    for d in "$base"/*; do
      [ -d "$d" ] || continue
      name="${d##*/}"
      [ -n "$name" ] || continue
      case "$name" in
        "."|"..") continue ;;
      esac
      printf '%s\n' "$name"
    done
  done | awk 'BEGIN{IGNORECASE=1} !seen[tolower($0)]++ { print }'
}

name_is_dark() {
  name_lc="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
  case "$name_lc" in
    *dark*|*black*|*night*|*noir*|*mocha*)
      return 0
      ;;
  esac
  return 1
}

name_is_light() {
  name_lc="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
  case "$name_lc" in
    *light*|*white*|*day*|*latte*)
      return 0
      ;;
  esac
  return 1
}

pick_icon_theme() {
  mode="$1"

  if [ "$mode" = "dark" ]; then
    for t in Tela-dark Papirus-Dark breeze-dark Tela Papirus Adwaita hicolor; do
      if have_icon_theme "$t"; then
        printf '%s\n' "$t"
        return 0
      fi
    done
    while IFS= read -r t; do
      [ -n "$t" ] || continue
      if name_is_dark "$t"; then
        printf '%s\n' "$t"
        return 0
      fi
    done <<EOF
$(list_installed_names icons)
EOF
  else
    for t in Tela Papirus breeze Kora Adwaita hicolor; do
      if have_icon_theme "$t"; then
        printf '%s\n' "$t"
        return 0
      fi
    done
    while IFS= read -r t; do
      [ -n "$t" ] || continue
      if name_is_light "$t"; then
        printf '%s\n' "$t"
        return 0
      fi
    done <<EOF
$(list_installed_names icons)
EOF
    while IFS= read -r t; do
      [ -n "$t" ] || continue
      if ! name_is_dark "$t"; then
        printf '%s\n' "$t"
        return 0
      fi
    done <<EOF
$(list_installed_names icons)
EOF
  fi

  while IFS= read -r t; do
    [ -n "$t" ] || continue
    printf '%s\n' "$t"
    return 0
  done <<EOF
$(list_installed_names icons)
EOF

  printf 'hicolor\n'
}

pick_gtk_theme() {
  mode="$1"

  if [ "$mode" = "dark" ]; then
    for t in Breeze-Dark Adwaita-dark Graphite-Dark GraphiteDark Catppuccin-Mocha-Standard-Blue-Dark Adwaita; do
      if theme_exists "$t"; then
        printf '%s\n' "$t"
        return 0
      fi
    done
    while IFS= read -r t; do
      [ -n "$t" ] || continue
      if name_is_dark "$t"; then
        printf '%s\n' "$t"
        return 0
      fi
    done <<EOF
$(list_installed_names themes)
EOF
  else
    for t in Breeze Adwaita Graphite-Light GraphiteLight Catppuccin-Latte-Standard-Blue-Light Adwaita-dark; do
      if theme_exists "$t"; then
        printf '%s\n' "$t"
        return 0
      fi
    done
    while IFS= read -r t; do
      [ -n "$t" ] || continue
      if name_is_light "$t"; then
        printf '%s\n' "$t"
        return 0
      fi
    done <<EOF
$(list_installed_names themes)
EOF
    while IFS= read -r t; do
      [ -n "$t" ] || continue
      if ! name_is_dark "$t"; then
        printf '%s\n' "$t"
        return 0
      fi
    done <<EOF
$(list_installed_names themes)
EOF
  fi

  while IFS= read -r t; do
    [ -n "$t" ] || continue
    printf '%s\n' "$t"
    return 0
  done <<EOF
$(list_installed_names themes)
EOF

  printf 'Adwaita\n'
}

set_ini_key() {
  file="$1"
  key="$2"
  value="$3"

  if [ ! -f "$file" ]; then
    printf '[Settings]\n' > "$file"
  fi

  if ! grep -q '^\[Settings\]' "$file"; then
    tmp_header="$(mktemp)"
    {
      printf '[Settings]\n'
      cat "$file"
    } > "$tmp_header"
    mv "$tmp_header" "$file"
  fi

  tmp_file="$(mktemp)"
  awk -v k="$key" -v v="$value" '
    BEGIN { done=0 }
    $0 ~ "^" k "=" {
      if (!done) {
        print k "=" v
        done=1
      }
      next
    }
    { print }
    END { if (!done) print k "=" v }
  ' "$file" > "$tmp_file"
  mv "$tmp_file" "$file"
}

mode_arg="${1:-}"
if [ "$mode_arg" = "--sync-from-tokens" ] || [ "$mode_arg" = "--sync-from-css" ] || [ -z "$mode_arg" ]; then
  mode_arg=""
fi

mode="$mode_arg"
if [ -z "$mode" ]; then
  mode="$(toml_get "$theme_tokens" "theme" "mode" 2>/dev/null || true)"
fi
if [ -z "$mode" ]; then
  mode="$(read_mode_from_file || true)"
fi
if [ -z "$mode" ]; then
  mode="$(read_mode_from_css || true)"
fi
if [ -z "$mode" ]; then
  mode="auto"
fi

case "$mode" in
  light|dark|auto) ;;
  *) mode="auto" ;;
esac

printf '%s\n' "$mode" > "$config_root/theme-mode"

resolved="$mode"
if [ "$mode" = "auto" ]; then
  hour="$(date +%H)"
  if [ "$hour" -ge 19 ] || [ "$hour" -lt 7 ]; then
    resolved="dark"
  else
    resolved="light"
  fi
fi

layout_top_height="$(token_or_default "$theme_tokens" "layout" "top_height" "42")"
layout_top_expanded_height="$(token_or_default "$theme_tokens" "layout" "top_expanded_height" "392")"
layout_side_width="$(token_or_default "$theme_tokens" "layout" "side_width" "74")"
layout_side_expanded_width="$(token_or_default "$theme_tokens" "layout" "side_expanded_width" "362")"

radius_quick_button="$(token_or_default "$theme_tokens" "radius" "quick_button" "13")"
radius_quick_panel="$(token_or_default "$theme_tokens" "radius" "quick_panel" "22")"
radius_quick_tile="$(token_or_default "$theme_tokens" "radius" "quick_tile" "14")"
radius_popup="$(token_or_default "$theme_tokens" "radius" "popup" "20")"

dialog_radius="$(token_or_default "$theme_tokens" "dialog" "radius" "14")"
dialog_spacing="$(token_or_default "$theme_tokens" "dialog" "spacing" "8")"

palette_section="palette.$resolved"
top_bg="$(token_or_default "$theme_tokens" "$palette_section" "top_bg" "#f7f4ff")"
top_text="$(token_or_default "$theme_tokens" "$palette_section" "top_text" "#2a2242")"
quick_button_bg="$(token_or_default "$theme_tokens" "$palette_section" "quick_button_bg" "#8b78f6")"
quick_button_fg="$(token_or_default "$theme_tokens" "$palette_section" "quick_button_fg" "#ffffff")"
quick_panel_bg="$(token_or_default "$theme_tokens" "$palette_section" "quick_panel_bg" "#fffdff")"
quick_tile_bg="$(token_or_default "$theme_tokens" "$palette_section" "quick_tile_bg" "#ebe6ff")"
quick_title_text="$(token_or_default "$theme_tokens" "$palette_section" "quick_title_text" "#2d2550")"
side_bg="$(token_or_default "$theme_tokens" "$palette_section" "side_bg" "#ece7ff")"
side_popup_bg="$(token_or_default "$theme_tokens" "$palette_section" "side_popup_bg" "#faf8ff")"
side_separator="$(token_or_default "$theme_tokens" "$palette_section" "side_separator" "#b9addf")"
side_launcher_bg="$(token_or_default "$theme_tokens" "$palette_section" "side_launcher_bg" "#8b78f6")"
side_slot_active="$(token_or_default "$theme_tokens" "$palette_section" "side_slot_active" "#74c7c2")"
side_slot_inactive="$(token_or_default "$theme_tokens" "$palette_section" "side_slot_inactive" "#8b84b7")"
surface_raised="$quick_panel_bg"
surface_subtle="$quick_tile_bg"
surface_overlay="$side_popup_bg"
border_subtle="$side_separator"
text_primary="$quick_title_text"
text_muted="$top_text"
accent_primary="$side_launcher_bg"
accent_success="$side_slot_active"
accent_neutral="$side_slot_inactive"

deco_title_bg_active="$(token_or_default "$theme_tokens" "$palette_section" "deco_title_bg_active" "#FBF8FFF2")"
deco_title_bg_inactive="$(token_or_default "$theme_tokens" "$palette_section" "deco_title_bg_inactive" "#EFE8FFDF")"
deco_border_active="$(token_or_default "$theme_tokens" "$palette_section" "deco_border_active" "#8E7AE9B8")"
deco_border_inactive="$(token_or_default "$theme_tokens" "$palette_section" "deco_border_inactive" "#AE9FD39A")"
deco_label_active="$(token_or_default "$theme_tokens" "$palette_section" "deco_label_active" "#2E2450")"
deco_label_inactive="$(token_or_default "$theme_tokens" "$palette_section" "deco_label_inactive" "#5D4F87")"
deco_hover_bg="$(token_or_default "$theme_tokens" "$palette_section" "deco_hover_bg" "#8B78F62A")"
deco_iconify_active="$(token_or_default "$theme_tokens" "$palette_section" "deco_iconify_active" "#708CFF")"
deco_max_active="$(token_or_default "$theme_tokens" "$palette_section" "deco_max_active" "#53C89A")"
deco_close_active="$(token_or_default "$theme_tokens" "$palette_section" "deco_close_active" "#EA6C92")"
deco_iconify_inactive="$(token_or_default "$theme_tokens" "$palette_section" "deco_iconify_inactive" "#96A7E2")"
deco_max_inactive="$(token_or_default "$theme_tokens" "$palette_section" "deco_max_inactive" "#8EC4A7")"
deco_close_inactive="$(token_or_default "$theme_tokens" "$palette_section" "deco_close_inactive" "#CC8FA8")"
deco_button_unpressed_active="$(token_or_default "$theme_tokens" "$palette_section" "deco_button_unpressed_active" "#5C4D8B")"
deco_button_unpressed_inactive="$(token_or_default "$theme_tokens" "$palette_section" "deco_button_unpressed_inactive" "#8E82B8")"

shell_css="$config_root/shell.css"
cat > "$shell_css" <<EOF
:root {
  --theme-mode: $mode;
  --top-height: $layout_top_height;
  --top-expanded-height: $layout_top_expanded_height;
  --side-width: $layout_side_width;
  --side-expanded-width: $layout_side_expanded_width;
  --quick-button-radius: $radius_quick_button;
  --quick-panel-radius: $radius_quick_panel;
  --quick-tile-radius: $radius_quick_tile;
  --popup-radius: $radius_popup;
  --top-bg: $top_bg;
  --top-text: $top_text;
  --quick-button-bg: $quick_button_bg;
  --quick-button-fg: $quick_button_fg;
  --quick-panel-bg: $quick_panel_bg;
  --quick-tile-bg: $quick_tile_bg;
  --quick-title-text: $quick_title_text;
  --side-bg: $side_bg;
  --side-popup-bg: $side_popup_bg;
  --side-separator: $side_separator;
  --side-launcher-bg: $side_launcher_bg;
  --side-slot-active: $side_slot_active;
  --side-slot-inactive: $side_slot_inactive;
}
EOF

gtk_font="$(token_or_default "$theme_tokens" "gtk" "font" "Inter 10")"
deco_layout="$(token_or_default "$theme_tokens" "gtk" "decoration_layout" "minimize,maximize,close")"
gtk_theme_light="$(token_or_default "$theme_tokens" "gtk" "gtk_theme_light" "")"
gtk_theme_dark="$(token_or_default "$theme_tokens" "gtk" "gtk_theme_dark" "")"
icon_theme_light="$(token_or_default "$theme_tokens" "gtk" "icon_theme_light" "")"
icon_theme_dark="$(token_or_default "$theme_tokens" "gtk" "icon_theme_dark" "")"

if [ "$resolved" = "dark" ]; then
  gtk_theme="$gtk_theme_dark"
  icon_theme="$icon_theme_dark"
else
  gtk_theme="$gtk_theme_light"
  icon_theme="$icon_theme_light"
fi

if [ -z "$gtk_theme" ] || ! theme_exists "$gtk_theme"; then
  gtk_theme="$(pick_gtk_theme "$resolved")"
fi
if [ -z "$icon_theme" ] || ! have_icon_theme "$icon_theme"; then
  icon_theme="$(pick_icon_theme "$resolved")"
fi

prefer_dark="false"
if [ "$resolved" = "dark" ]; then
  prefer_dark="true"
fi

gtk3="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-3.0/settings.ini"
gtk4="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-4.0/settings.ini"
session_env="$config_root/environment"

set_ini_key "$gtk3" "gtk-application-prefer-dark-theme" "$prefer_dark"
set_ini_key "$gtk3" "gtk-theme-name" "$gtk_theme"
set_ini_key "$gtk3" "gtk-icon-theme-name" "$icon_theme"
set_ini_key "$gtk3" "gtk-font-name" "$gtk_font"
set_ini_key "$gtk3" "gtk-decoration-layout" "$deco_layout"

set_ini_key "$gtk4" "gtk-application-prefer-dark-theme" "$prefer_dark"
set_ini_key "$gtk4" "gtk-theme-name" "$gtk_theme"
set_ini_key "$gtk4" "gtk-icon-theme-name" "$icon_theme"
set_ini_key "$gtk4" "gtk-font-name" "$gtk_font"
set_ini_key "$gtk4" "gtk-decoration-layout" "$deco_layout"

gtk3_css="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-3.0/gtk.css"
gtk4_css="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-4.0/gtk.css"

cat > "$gtk3_css" <<EOF
/* Generated by karton-apply-theme */
@define-color karton_window_bg $surface_raised;
@define-color karton_panel_bg $surface_overlay;
@define-color karton_card_bg $surface_subtle;
@define-color karton_border $border_subtle;
@define-color karton_fg $text_primary;
@define-color karton_fg_muted $text_muted;
@define-color karton_accent $accent_primary;
@define-color karton_success $accent_success;
@define-color karton_neutral $accent_neutral;

window,
dialog,
.background {
  background-color: @karton_window_bg;
  color: @karton_fg;
}

decoration,
window.csd decoration {
  background-color: alpha(@karton_window_bg, 0.96);
  border: 1px solid alpha(@karton_border, 0.68);
  border-radius: ${radius_popup}px;
  box-shadow: 0 18px 48px rgba(18, 12, 36, 0.22), 0 2px 10px rgba(18, 12, 36, 0.08);
}

headerbar,
headerbar.default-decoration,
titlebar {
  background-image: none;
  background-color: alpha(@karton_panel_bg, 0.92);
  border: none;
  box-shadow: inset 0 -1px alpha(@karton_border, 0.45);
  color: @karton_fg;
}

button,
.button,
modelbutton,
spinbutton,
