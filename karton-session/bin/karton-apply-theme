sourceview {
  background: alpha(@karton_panel_bg, 0.86);
  border: 1px solid alpha(@karton_border, 0.76);
  color: @karton_fg;
  caret-color: @karton_accent;
}

entry selection,
text selection,
label selection,
listview row:selected,
columnview row:selected,
navigation-sidebar row:selected,
flowboxchild:selected {
  background: alpha(@karton_accent, 0.22);
  color: @karton_fg;
}

headerbar,
headerbar.titlebar,
windowhandle > box,
toolbar {
  background: alpha(@karton_panel_bg, 0.92);
  color: @karton_fg;
  box-shadow: inset 0 -1px alpha(@karton_border, 0.45);
}

headerbar button,
toolbar button,
tabbar tab {
  min-height: 34px;
}

progressbar > trough,
scale > trough,
levelbar block.empty,
scrollbar trough {
  background: alpha(@karton_card_bg, 0.72);
  border: 1px solid alpha(@karton_border, 0.38);
}

progressbar > trough > progress,
scale > trough > highlight,
levelbar block.filled,
scrollbar slider {
  background: @karton_accent;
}

scrollbar slider {
  min-width: 8px;
  min-height: 8px;
  border-radius: 999px;
}

check,
radio {
  min-width: 18px;
  min-height: 18px;
  border-radius: 999px;
  border: 1px solid alpha(@karton_border, 0.8);
  background: alpha(@karton_panel_bg, 0.92);
}

window.csd,
window.csd decoration,
window.csd .background {
  border: none;
  border-radius: 0;
  box-shadow: none;
}

window.csd headerbar.titlebar,
window.csd titlebar,
window.csd .titlebar {
  min-height: 0;
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  box-shadow: none;
}

window.csd headerbar.titlebar > *,
window.csd titlebar > *,
window.csd .titlebar > * {
  min-height: 0;
  padding: 0;
  margin: 0;
  opacity: 0;
}
EOF

cat > "$session_env" <<EOF
# Generated by karton-apply-theme
# Keep GTK apps visually aligned with KartON/Tektura server-side decorations.

GTK_CSD=0
GTK_THEME=$gtk_theme
EOF

cat > "$config_root/themerc-override" <<EOF
# KartonDE decorations override
# Synced by karton-apply-theme ($resolved)

window.active.title.bg: Solid
window.inactive.title.bg: Solid
window.active.title.bg.color: $deco_title_bg_active
window.inactive.title.bg.color: $deco_title_bg_inactive

window.active.border.color: $deco_border_active
window.inactive.border.color: $deco_border_inactive

window.active.shadow.size: 64
window.inactive.shadow.size: 40
window.active.shadow.color: #00000045
window.inactive.shadow.color: #0000002A

window.active.label.text.color: $deco_label_active
window.inactive.label.text.color: $deco_label_inactive
window.label.text.justify: Left

window.titlebar.padding.width: 8
window.titlebar.padding.height: 6
window.title.separator.width: 0

window.button.width: 14
window.button.height: 14
window.button.spacing: 6
window.button.hover.bg.corner-radius: 9
window.button.hover.bg.color: $deco_hover_bg

window.active.button.unpressed.image.color: $deco_button_unpressed_active
window.inactive.button.unpressed.image.color: $deco_button_unpressed_inactive

window.active.button.iconify.unpressed.image.color: $deco_iconify_active
window.active.button.max.unpressed.image.color: $deco_max_active
window.active.button.close.unpressed.image.color: $deco_close_active

window.inactive.button.iconify.unpressed.image.color: $deco_iconify_inactive
window.inactive.button.max.unpressed.image.color: $deco_max_inactive
window.inactive.button.close.unpressed.image.color: $deco_close_inactive
EOF

cat > "$config_root/dialogd.conf" <<EOF
# Generated by karton-apply-theme
# Do not edit manually

theme_mode=$mode
effective_mode=$resolved
panel_bg=$quick_panel_bg
text_color=$quick_title_text
accent_color=$side_launcher_bg
dialog_radius=$dialog_radius
dialog_spacing=$dialog_spacing
EOF

if command -v karton >/dev/null 2>&1; then
  karton --reconfigure >/dev/null 2>&1 || true
fi
if [ -n "${KARTON_PID:-}" ]; then
  kill -HUP "$KARTON_PID" >/dev/null 2>&1 || true
fi

exit 0
