flowboxchild {
  border-radius: ${radius_quick_tile}px;
}

button,
.button,
modelbutton {
  background-image: none;
  background-color: alpha(@karton_card_bg, 0.9);
  border: 1px solid alpha(@karton_border, 0.72);
  color: @karton_fg;
  box-shadow: none;
}

button:hover,
.button:hover,
modelbutton:hover {
  background-color: shade(@karton_card_bg, 1.04);
}

button:checked,
button:active,
.button:checked,
.button:active,
modelbutton:checked,
modelbutton:active,
button.suggested-action,
.suggested-action {
  background-image: none;
  background-color: @karton_accent;
  border-color: alpha(@karton_accent, 0.88);
  color: #ffffff;
}

button.destructive-action,
.destructive-action {
  background-image: none;
  background-color: $deco_close_active;
  border-color: alpha($deco_close_active, 0.88);
  color: #ffffff;
}

entry,
searchentry,
spinbutton,
combobox box,
textview,
textview text,
treeview.view {
  background-image: none;
  background-color: alpha(@karton_panel_bg, 0.86);
  border: 1px solid alpha(@karton_border, 0.76);
  color: @karton_fg;
  caret-color: @karton_accent;
}

entry selection,
textview text selection,
treeview.view:selected,
iconview:selected,
flowboxchild:selected,
list row:selected {
  background-color: alpha(@karton_accent, 0.22);
  color: @karton_fg;
}

popover,
menu,
.menu,
.context-menu {
  background-color: alpha(@karton_panel_bg, 0.98);
  border: 1px solid alpha(@karton_border, 0.76);
  border-radius: ${radius_quick_panel}px;
  box-shadow: 0 18px 46px rgba(16, 10, 32, 0.22);
  color: @karton_fg;
}

list row,
treeview.view,
flowboxchild,
calendar {
  background-color: alpha(@karton_card_bg, 0.68);
  border: 1px solid alpha(@karton_border, 0.38);
  color: @karton_fg;
}

scrollbar slider {
  background-color: alpha(@karton_neutral, 0.6);
  border-radius: 999px;
}

progressbar progress,
scale highlight {
  background-color: @karton_accent;
  border-radius: 999px;
}

window.csd decoration {
  border-radius: 14px 14px 14px 14px;
  box-shadow: 0 18px 48px rgba(18,12,36,0.22), 0 2px 10px rgba(18,12,36,0.08);
}
window.csd:backdrop decoration {
  box-shadow: 0 10px 28px rgba(18,12,36,0.12);
}
EOF

cat > "$gtk4_css" <<EOF
/* Generated by karton-apply-theme */
@define-color karton_window_bg $surface_raised;
@define-color karton_panel_bg $surface_overlay;
@define-color karton_card_bg $surface_subtle;
@define-color karton_border $border_subtle;
@define-color karton_fg $text_primary;
@define-color karton_fg_muted $text_muted;
@define-color karton_accent $accent_primary;
@define-color karton_success $accent_success;
@define-color karton_neutral $accent_neutral;

window,
dialog,
.background,
box,
paned,
stack,
frame > border {
  color: @karton_fg;
}

window,
dialog,
.background {
  background: @karton_window_bg;
}

popover.background,
menu,
menuitem,
.context-menu {
  background: alpha(@karton_panel_bg, 0.98);
  color: @karton_fg;
}

popover.background {
  border: 1px solid alpha(@karton_border, 0.76);
  border-radius: ${radius_quick_panel}px;
  box-shadow: 0 22px 54px rgba(16, 10, 32, 0.24);
}

