[theme]
mode = "auto"

[layout]
top_height = 42
top_expanded_height = 392
side_width = 74
side_expanded_width = 362

[radius]
quick_button = 16
quick_panel = 28
quick_tile = 18
popup = 24

[dialog]
radius = 16
spacing = 10

[gtk]
font = "Inter 10"
decoration_layout = "minimize,maximize,close"
# Optional explicit themes/icons per mode (leave empty for auto-pick)
gtk_theme_light = ""
gtk_theme_dark = ""
icon_theme_light = ""
icon_theme_dark = ""

[palette.light]
top_bg = "#f6f2ff"
top_text = "#241c3d"
quick_button_bg = "#7f67f8"
quick_button_fg = "#ffffff"
quick_panel_bg = "#fffaff"
quick_tile_bg = "#f0eaff"
quick_title_text = "#261e45"
side_bg = "#efe9ff"
side_popup_bg = "#f9f5ff"
side_separator = "#c2b4ea"
side_launcher_bg = "#7f67f8"
side_slot_active = "#56c8b1"
side_slot_inactive = "#8577b4"

deco_title_bg_active = "#FCF8FFF4"
deco_title_bg_inactive = "#EEE6FFDF"
deco_border_active = "#8971F0C0"
deco_border_inactive = "#B1A0DA9A"
deco_label_active = "#281F46"
deco_label_inactive = "#5C4E84"
deco_hover_bg = "#7F67F82D"
deco_iconify_active = "#6888FF"
deco_max_active = "#49C8A0"
deco_close_active = "#E86A97"
deco_iconify_inactive = "#97A8E0"
deco_max_inactive = "#91C5AE"
deco_close_inactive = "#CA8BA5"
deco_button_unpressed_active = "#56487F"
deco_button_unpressed_inactive = "#8A7FB3"

[palette.dark]
top_bg = "#191526"
top_text = "#f1edff"
quick_button_bg = "#9a85ff"
quick_button_fg = "#ffffff"
quick_panel_bg = "#201a31"
quick_tile_bg = "#2b2340"
quick_title_text = "#f3efff"
side_bg = "#251d39"
side_popup_bg = "#1d172f"
side_separator = "#706394"
side_launcher_bg = "#9a85ff"
side_slot_active = "#5fd5bb"
side_slot_inactive = "#8d84bd"

deco_title_bg_active = "#171133EE"
deco_title_bg_inactive = "#251D46DE"
deco_border_active = "#9A85FFC8"
deco_border_inactive = "#76679F9E"
deco_label_active = "#F5F0FF"
deco_label_inactive = "#C7BDE8"
deco_hover_bg = "#D9D0FF32"
deco_iconify_active = "#AAB8FF"
deco_max_active = "#79D6B6"
deco_close_active = "#FF8DAE"
deco_iconify_inactive = "#9DADDE"
deco_max_inactive = "#84BC9F"
deco_close_inactive = "#BE88A2"
deco_button_unpressed_active = "#E1D7FF"
deco_button_unpressed_inactive = "#AAA0D3"
